{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "rootDir": "..",
    "outDir": "dist",
    "paths": {
      "happy-wire": ["../happy-wire/src/index.ts"],
      "happy-wire/*": ["../happy-wire/src/*"]
    }
  },
  "include": ["src", "../happy-wire/src"]
}
