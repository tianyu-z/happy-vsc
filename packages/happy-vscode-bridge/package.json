{
  "name": "happy-vscode-bridge",
  "displayName": "Happy Companion",
  "description": "VS Code extension bridge for the Happy Companion broker.",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/extension.cjs",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:happyVscodeBridge.refreshSessions"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "happyVscodeBridge",
          "title": "Happy Companion",
          "icon": "resources/bridge.svg"
        }
      ]
    },
    "views": {
      "happyVscodeBridge": [
        {
          "id": "happyVscodeBridge.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "happyVscodeBridge.startBroker",
        "title": "Happy Companion: Start Broker"
      },
      {
        "command": "happyVscodeBridge.stopBroker",
        "title": "Happy Companion: Stop Broker"
      },
      {
        "command": "happyVscodeBridge.refreshSessions",
        "title": "Happy Companion: Refresh Sessions"
      },
      {
        "command": "happyVscodeBridge.switchSessionMode",
        "title": "Happy Companion: Switch Session Mode"
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "build": "node ./esbuild.mjs",
    "package:vsix": "vsce package --no-dependencies",
    "test": "vitest run"
  },
  "dependencies": {
    "happy-wire": "*",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/node": ">=20",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.27.4",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
