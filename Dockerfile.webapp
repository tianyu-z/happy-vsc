# syntax=docker/dockerfile:1.7

# Build the web bundle without baking node_modules into an image layer.
# The happy-app workspace is large enough that persisting dependencies in the
# layer can exhaust Docker's writable layer even when the host still has space.
FROM node:20-alpine AS builder

WORKDIR /repo

COPY package.json yarn.lock ./

# Keep dependency installation scoped to web-only workspaces to avoid
# pulling the entire monorepo dependency graph.
RUN node -e "const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json','utf8'));if(typeof p.workspaces==='object'&&p.workspaces){p.workspaces={...p.workspaces,packages:['packages/happy-app','packages/happy-wire']};}fs.writeFileSync('package.json',JSON.stringify(p,null,2));"

ARG POSTHOG_API_KEY=""
ARG REVENUE_CAT_STRIPE=""

ENV NODE_ENV=development
ENV APP_ENV=production
ENV EXPO_PUBLIC_POSTHOG_API_KEY=$POSTHOG_API_KEY
ENV EXPO_PUBLIC_REVENUE_CAT_STRIPE=$REVENUE_CAT_STRIPE
ENV EXPO_PUBLIC_ELEVENLABS_AGENT_ID=__RT_ELEVENLABS_AGENT_ID__
ENV EXPO_PUBLIC_HAPPY_SERVER_URL=__RT_HAPPY_SERVER_URL__
ENV EXPO_PUBLIC_VOICE_PROVIDER=__RT_VOICE_PROVIDER__
ENV EXPO_PUBLIC_VOICE_BASE_URL=__RT_VOICE_BASE_URL__
ENV EXPO_PUBLIC_VOICE_PUBLIC_KEY=__RT_VOICE_PUBLIC_KEY__
ENV EXPO_PUBLIC_VOICE_TOOL_BRIDGE_BASE_URL=__RT_VOICE_TOOL_BRIDGE_BASE_URL__

COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-app ./packages/happy-app

RUN --mount=type=cache,id=happy-yarn-cache-webapp-v3,target=/usr/local/share/.cache/yarn,sharing=locked \
    --mount=type=cache,id=happy-webapp-root-node-modules-v3,target=/repo/node_modules,sharing=locked \
    --mount=type=cache,id=happy-webapp-app-node-modules-v3,target=/repo/packages/happy-app/node_modules,sharing=locked \
    --mount=type=cache,id=happy-webapp-wire-node-modules-v3,target=/repo/packages/happy-wire/node_modules,sharing=locked \
    yarn install --frozen-lockfile --ignore-engines && \
    yarn workspace happy-wire build && \
    cd /repo/packages/happy-app && \
    NODE_ENV=production /repo/node_modules/.bin/expo export --platform web --output-dir dist

# Runtime with Nginx
FROM nginx:alpine AS runner

COPY --from=builder /repo/packages/happy-app/dist /usr/share/nginx/html
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Remove default nginx configuration
RUN rm /etc/nginx/conf.d/default.conf

# Create custom nginx configuration directly in the Dockerfile
RUN echo 'server { \
    listen 80; \
    \
    location /_expo/ { \
        root   /usr/share/nginx/html; \
        try_files $uri =404; \
    } \
    \
    location /assets/ { \
        root   /usr/share/nginx/html; \
        try_files $uri =404; \
    } \
    \
    location /.well-known/ { \
        root   /usr/share/nginx/html; \
        try_files $uri =404; \
    } \
    \
    location / { \
        root   /usr/share/nginx/html; \
        index  index.html index.htm; \
        try_files $uri $uri.html $uri/index.html $uri/index.htm $uri/ /index.html /index.htm =404; \
    } \
    \
    error_page 500 502 503 504 /50x.html; \
    location = /50x.html { \
        root /usr/share/nginx/html; \
        try_files $uri @redirect_to_index; \
        internal; \
    } \
    \
    error_page 404 = @handle_404; \
    \
    location @handle_404 { \
        root /usr/share/nginx/html; \
        try_files /404.html @redirect_to_index; \
        internal; \
    } \
    \
    location @redirect_to_index { \
        return 302 /; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

ENTRYPOINT ["/entrypoint.sh"]
